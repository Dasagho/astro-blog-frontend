---
import Layout from '../layouts/Layout.astro';
import PostCard from '../components/PostCard.astro';
import { getPosts, getSettings } from '../lib/ghost';

const [posts, settings] = await Promise.all([getPosts(), getSettings()]);
---

<Layout>
  <div class="container">
    <header class="intro">
      <h1>{settings.title}</h1>
      {settings.description && <p>{settings.description}</p>}
    </header>

    {posts.length === 0 ? (
      <p class="empty">Todavía no hay posts publicados.</p>
    ) : (
      <ol class="posts" role="list">
        {posts.map((post) => (
          <li>
            <PostCard post={post} />
          </li>
        ))}
      </ol>
    )}
  </div>
</Layout>

<style>
  .intro {
    margin-bottom: var(--space-xl);
  }
  .intro h1 { font-size: var(--step-3); }
  .intro p {
    margin: var(--space-xs) 0 0;
    color: var(--muted);
    font-size: var(--step-1);
  }
  .posts {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-xl);
  }
  .empty { color: var(--muted); }
</style>
