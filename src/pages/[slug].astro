---
import type { GetStaticPaths } from 'astro';
import Layout from '../layouts/Layout.astro';
import PostMeta from '../components/PostMeta.astro';
import PostBody from '../components/PostBody.astro';
import { excerptOf, getPages, getPosts, type Post } from '../lib/ghost';

export const getStaticPaths = (async () => {
  const [posts, pages] = await Promise.all([getPosts(), getPages()]);
  // Slugs que chocan con rutas propias del frontend (/tag/, /author/, /rss.xml...)
  const reserved = new Set(['tag', 'author', 'rss', '404']);
  const seen = new Set<string>();
  const entries = [
    ...posts.map((post) => ({ post, isPage: false })),
    ...pages.map((post) => ({ post, isPage: true })),
  ].filter(({ post }) => {
    if (reserved.has(post.slug) || seen.has(post.slug)) {
      console.warn(`[ghost] slug "${post.slug}" duplicado o reservado: se omite.`);
      return false;
    }
    seen.add(post.slug);
    return true;
  });
  return entries.map(({ post, isPage }) => ({ params: { slug: post.slug }, props: { post, isPage } }));
}) satisfies GetStaticPaths;

interface Props {
  post: Post;
  isPage: boolean;
}

const { post, isPage } = Astro.props;
---

<Layout title={post.title} description={excerptOf(post)}>
  <article>
    <header class="container post-header">
      <h1 transition:name={`title-${post.slug}`}>{post.title}</h1>
      {!isPage && <PostMeta post={post} />}
    </header>

    {post.feature_image && (
      <figure class="feature">
        <img
          src={post.feature_image}
          alt={post.feature_image_alt ?? ''}
          transition:name={`post-image-${post.slug}`}
        />
        {post.feature_image_caption && <figcaption set:html={post.feature_image_caption} />}
      </figure>
    )}

    {post.html && <PostBody html={post.html} />}

    {!post.access && (
      <p class="container locked">
        Este contenido es solo para miembros y no está disponible en este sitio.
      </p>
    )}

    {!isPage && (
      <nav class="container back">
        <a href="/">← Todos los posts</a>
      </nav>
    )}
  </article>
</Layout>

<style>
  .post-header {
    display: grid;
    gap: var(--space-s);
    margin-bottom: var(--space-l);
  }
  h1 { font-size: var(--step-3); }

  .feature {
    width: min(var(--wide), 100% - 2 * var(--gutter));
    margin: 0 auto var(--space-l);
  }
  .feature img {
    width: 100%;
    border-radius: var(--radius);
  }
  .feature figcaption {
    margin-top: 0.6em;
    font-family: var(--font-ui);
    font-size: var(--step--1);
    color: var(--muted);
    text-align: center;
  }

  .locked {
    margin-top: var(--space-m);
    padding: var(--space-s) var(--space-m);
    border-radius: var(--radius);
    background: var(--surface);
    font-family: var(--font-ui);
    color: var(--muted);
  }

  .back {
    margin-top: var(--space-xl);
    font-family: var(--font-ui);
    font-size: var(--step--1);
  }
</style>
