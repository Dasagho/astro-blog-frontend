---
import '../styles/content.css';
import { getSettings, localizeHtml } from '../lib/ghost';

interface Props {
  html: string;
}

const { html } = Astro.props;
const { url } = await getSettings();
---

<div class="gh-content" set:html={localizeHtml(html, url)} />

<script>
  // Interactividad mínima de las tarjetas de Ghost. Se re-ejecuta tras cada
  // navegación del ClientRouter (astro:page-load), no solo en la carga inicial.
  function initGalleries() {
    document.querySelectorAll<HTMLImageElement>('.kg-gallery-image img').forEach((img) => {
      const w = Number(img.getAttribute('width'));
      const h = Number(img.getAttribute('height'));
      if (w && h) img.closest<HTMLElement>('.kg-gallery-image')!.style.flex = `${w / h} 1 0`;
    });
  }

  function initToggles() {
    document.querySelectorAll<HTMLElement>('.kg-toggle-card').forEach((card) => {
      card.querySelector('.kg-toggle-heading')?.addEventListener('click', () => {
        const open = card.dataset.kgToggleState === 'open';
        card.dataset.kgToggleState = open ? 'close' : 'open';
      });
    });
  }

  // Vídeo y audio: Ghost emite un reproductor propio que depende de su JS de
  // tema; se sustituye por los controles nativos del navegador.
  function initMedia() {
    document.querySelectorAll<HTMLMediaElement>('.kg-video-card video, .kg-audio-card audio').forEach((el) => {
      el.controls = true;
    });
  }

  document.addEventListener('astro:page-load', () => {
    initGalleries();
    initMedia();
    initToggles();
  });
</script>
