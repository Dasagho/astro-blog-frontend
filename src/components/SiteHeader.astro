---
import { localPath, type NavItem } from '../lib/ghost';

interface Props {
  title: string;
  logo: string | null;
  siteUrl: string;
  navigation: NavItem[];
}

const { title, logo, siteUrl, navigation } = Astro.props;
const isHome = Astro.url.pathname === '/';
const current = (href: string) => (Astro.url.pathname === href ? 'page' : undefined);
---

<header class="site-header" transition:persist="site-header">
  <div class="container inner">
    <a class="brand" href="/" aria-current={isHome ? 'page' : undefined}>
      {logo ? <img src={logo} alt={title} /> : title}
    </a>
    {navigation.length > 0 && (
      <nav aria-label="Principal">
        <ul role="list">
          {navigation.map((item) => {
            const href = localPath(item.url, siteUrl);
            return (
              <li>
                <a href={href} aria-current={current(href)}>{item.label}</a>
              </li>
            );
          })}
        </ul>
      </nav>
    )}
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--border);
    font-family: var(--font-ui);
  }
  .inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 4rem;
  }
  .brand {
    font-weight: 500;
    font-size: var(--step-0);
    letter-spacing: -0.01em;
    text-decoration: none;
  }
  nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s);
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: var(--step--1);
  }
  nav a { text-decoration: none; }
  nav a[aria-current='page'] { color: var(--accent); }
  .brand img { max-height: 2rem; width: auto; }
</style>
