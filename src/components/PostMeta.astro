---
import { formatDate, publicTags, type Post } from '../lib/ghost';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const tags = publicTags(post);
---

<p class="meta" transition:name={`post-meta-${post.slug}`}>
  <time datetime={post.published_at}>{formatDate(post.published_at)}</time>
  <span aria-hidden="true">·</span>
  <span>{post.reading_time} min</span>
  {tags.map((tag) => (
    <>
      <span aria-hidden="true">·</span>
      <a class="tag" href={`/tag/${tag.slug}/`}>{tag.name}</a>
    </>
  ))}
</p>

<style>
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5em;
    margin: 0;
    font-family: var(--font-ui);
    font-size: var(--step--1);
    color: var(--muted);
  }
  .tag { color: var(--accent); text-decoration: none; }
  .tag:hover { text-decoration: underline; }
</style>
