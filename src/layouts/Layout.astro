---
import { ClientRouter, fade } from 'astro:transitions';
import { getSettings } from '../lib/ghost';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const settings = await getSettings();
const { title, description = settings.description } = Astro.props;
const pageTitle = title ? `${title} · ${settings.title}` : settings.title;
const accent = settings.accent_color ? `--accent: ${settings.accent_color}` : undefined;
---

<!doctype html>
<html lang="es" style={accent}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    {description && <meta name="description" content={description} />}
    {settings.icon && <link rel="icon" href={settings.icon} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400&family=IBM+Plex+Sans:wght@300;400;500;600&family=Newsreader:ital,opsz,wght@0,6..72,300..600;1,6..72,300..600&display=swap"
    />
    <link rel="alternate" type="application/rss+xml" title={settings.title} href="/rss.xml" />
    <ClientRouter />
    {settings.codeinjection_head && <Fragment set:html={settings.codeinjection_head} />}
  </head>
  <body>
    <SiteHeader
      title={settings.title}
      logo={settings.logo}
      siteUrl={settings.url}
      navigation={settings.navigation}
    />
    <main transition:animate={fade({ duration: '0.2s' })}>
      <slot />
    </main>
    <SiteFooter
      title={settings.title}
      siteUrl={settings.url}
      navigation={settings.secondary_navigation}
    />
    {settings.codeinjection_foot && <Fragment set:html={settings.codeinjection_foot} />}
  </body>
</html>

<style>
  main {
    flex: 1;
    padding-block: var(--space-l) var(--space-xl);
  }
</style>
