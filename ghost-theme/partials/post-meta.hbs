<p class="meta" style="view-transition-name: post-meta-{{slug}}">
    <time datetime="{{date published_at format="YYYY-MM-DD"}}">{{date published_at format="D [de] MMMM [de] YYYY"}}</time>
    <span aria-hidden="true">·</span>
    <span>{{reading_time minute="1 min" minutes="% min"}}</span>
    {{tags prefix="· " separator=" · " autolink="true"}}
</p>
