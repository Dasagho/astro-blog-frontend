{{!< default}}
<div class="container">
    <header class="intro">
        <h1>{{tag.name}}</h1>
        {{#if tag.description}}<p>{{tag.description}}</p>{{/if}}
    </header>

    {{#if posts}}
    <ol class="posts" role="list">
        {{#foreach posts}}
        <li>{{> "post-card"}}</li>
        {{/foreach}}
    </ol>
    {{> "pager"}}
    {{else}}
    <p class="empty">Todavía no hay posts con esta etiqueta.</p>
    {{/if}}
</div>
