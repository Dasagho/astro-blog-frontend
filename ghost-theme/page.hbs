{{!< default}}
{{#post}}
<article class="{{post_class}}">
    {{#if @page.show_title_and_feature_image}}
    <header class="container post-header">
        <h1>{{title}}</h1>
    </header>
    {{/if}}

    {{#if @page.show_title_and_feature_image}}{{#if feature_image}}
    <figure class="feature">
        <img src="{{img_url feature_image size="l"}}" alt="{{feature_image_alt}}">
        {{#if feature_image_caption}}<figcaption>{{{feature_image_caption}}}</figcaption>{{/if}}
    </figure>
    {{/if}}{{/if}}

    <div class="post-body">
        {{content}}
    </div>
</article>
{{/post}}
