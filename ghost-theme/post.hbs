{{!< default}}
{{#post}}
<article class="{{post_class}}">
    <header class="container post-header">
        <h1 style="view-transition-name: title-{{slug}}">{{title}}</h1>
        {{> "post-meta"}}
    </header>

    {{#if feature_image}}
    <figure class="feature">
        <img src="{{img_url feature_image size="l"}}" alt="{{feature_image_alt}}" style="view-transition-name: post-image-{{slug}}">
        {{#if feature_image_caption}}<figcaption>{{{feature_image_caption}}}</figcaption>{{/if}}
    </figure>
    {{/if}}

    <div class="post-body">
        {{content}}
    </div>

    <nav class="container back">
        <a href="{{@site.url}}">← Todos los posts</a>
    </nav>
</article>
{{/post}}
